# IDRAAK Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API (for translation and extraction)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API (optional)
ANTHROPIC_API_KEY=

# Hugging Face (optional, for local models)
HF_TOKEN=

# Privacy: set to "true" to allow external API calls
IDRAAK_ALLOW_EXTERNAL_API=false

# Experiment tracking (optional)
WANDB_API_KEY=
MLFLOW_TRACKING_URI=
